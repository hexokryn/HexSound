{
  "name": "hexsound",
  "version": "0.11.0",
  "description": "SoundCloud desktop player with themes, lyrics, personal radio and file imports",
  "main": "src/main.cjs",
  "author": "hexokryn",
  "homepage": "https://github.com/hexokryn/HexSound",
  "repository": {
    "type": "git",
    "url": "https://github.com/hexokryn/HexSound.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz",
    "check:library": "electron . --library-test",
    "check:experience": "electron . --experience-test",
    "check:memory": "electron . --memory-test",
    "check:unified": "electron . --unified-test"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.hexsound.desktop",
    "productName": "HexSound",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico",
      "signExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "executableName": "hexsound",
      "artifactName": "HexSound-${version}-linux-${arch}.${ext}",
      "category": "AudioVideo",
      "icon": "src/assets/icons",
      "maintainer": "hexokryn <351071836+hexokryn@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "HexSound",
          "Keywords": "Music;Audio;SoundCloud;"
        }
      }
    },
    "nsis": {
      "artifactName": "HexSound-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "displayLanguageSelector": true,
      "runAfterFinish": true,
      "shortcutName": "HexSound"
    },
    "portable": {
      "artifactName": "HexSound-${version}-portable.exe"
    }
  }
}
