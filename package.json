{
  "name": "hexsound",
  "version": "0.6.0",
  "description": "SoundCloud desktop with a quiet Apple-inspired interface",
  "main": "src/main.cjs",
  "author": "hexokryn",
  "homepage": "https://github.com/hexokryn/HexSound",
  "repository": { "type": "git", "url": "https://github.com/hexokryn/HexSound.git" },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir"
  },
  "devDependencies": { "electron": "45.3.4", "electron-builder": "26.18.0" },
  "build": {
    "appId": "app.hexsound.desktop",
    "productName": "HexSound",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"], "icon": "src/assets/icon.ico", "signExecutable": false },
    "nsis": {
      "artifactName": "HexSound-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["en_US", "ru_RU"],
      "displayLanguageSelector": true,
      "runAfterFinish": true,
      "shortcutName": "HexSound"
    },
    "portable": { "artifactName": "HexSound-${version}-portable.exe" }
  }
}
